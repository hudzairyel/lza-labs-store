# LZA.LABS Environment

# Admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=change-this-to-a-random-64-char-secret

# Gmail SMTP (for OTP delivery)
# 1. Buka https://myaccount.google.com/signup -> Aktifkan "Autentikasi 2 langkah"
# 2. Buka https://myaccount.google.com/apppasswords
# 3. Buat app password (Nama: LZA.LABS)
# 4. Salin kode 16-karakter (contoh: abcd efgh ijkl mnop) -> hapus spasi -> tempel di bawah
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Midtrans (optional)
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SERVER_KEY=your-midtrans-server-key
